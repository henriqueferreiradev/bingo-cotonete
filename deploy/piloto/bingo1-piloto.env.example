# Variáveis do alvo bingo1-piloto. Copie para /etc/kordan/bingo1-piloto.env na VPS
# (chmod 600, fora do git) e troque todo valor TROQUE. Os dois slots e a migração usam este arquivo.
#
# Formato lido pelo executor: CHAVE=valor por linha, sem aspas e sem "export".
# O executor acrescenta KORDAN_SLOT, KORDAN_RELEASE_VERSION e KORDAN_IMAGE_DIGEST.

# PostgreSQL exclusivo do piloto, com dados fictícios, compartilhado pelos dois slots.
# Obrigatório: sem ele o core.settings_prod recusa subir pela Central.
# connect_timeout limita quanto o /healthz espera por um banco que não responde.
DATABASE_URL=postgres://bingo_piloto:TROQUE@bingo1-piloto-db:5432/bingo_piloto?connect_timeout=5

# Igual nos dois slots: sessões e tokens CSRF continuam válidos depois da troca.
SECRET_KEY=TROQUE-por-uma-chave-longa-e-aleatoria

# Domínio público do piloto [VPS]. Deve coincidir com slot_host_header do alvo.
DJANGO_ALLOWED_HOSTS=bingo-piloto.kordan.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://bingo-piloto.kordan.tech
# Gravado no Django Sites a cada migração (idempotente). Usado pelo allauth nas URLs de retorno.
DJANGO_SITE_DOMAIN=bingo-piloto.kordan.tech

# App do Discord do piloto (a página inicial precisa dele). Use um app separado do de produção,
# com o redirect https://bingo-piloto.kordan.tech/accounts/discord/login/callback/ cadastrado.
# Sem login real pelo Discord, um valor qualquer basta para a página abrir; entre por /accounts/login/.
DISCORD_CLIENT_ID=TROQUE
DISCORD_CLIENT_SECRET=TROQUE
